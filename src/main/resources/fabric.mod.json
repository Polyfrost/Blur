{
  "schemaVersion": 1,
  "id": "blur",
  "version": "${version}",
  "name": "Legacy GUI Blur",
  "description": "Configurable blur, gradients, and fade animations behind Minecraft GUIs",
  "authors": ["Motschen", "amiralimollaei", "tterrag1098", "Pyrofab"],
  "contact": {
    "homepage": "https://github.com/Polyfrost/Blur",
    "sources": "https://github.com/Polyfrost/Blur",
    "issues": "https://github.com/Polyfrost/Blur/issues"
  },
  "license": "MIT",
  "icon": "assets/blur/icon.png",
  "environment": "client",
  "entrypoints": {
	"client-init": ["eu.midnightdust.blur.Blur"],
	"modmenu": ["eu.midnightdust.blur.BlurModMenu"]
  },
  "mixins": ["blur.mixins.json"],
  "depends": {
    "minecraft": "1.8.9",
    "fabricloader": ">=0.19.3",
    "oneconfig": ">=1.1.12",
    "osl-entrypoints": ">=0.6.1",
    "osl-lifecycle-events": ">=0.6.1"
  },
  "suggests": {
    "modmenu": ">=0.5.0"
  }
}
